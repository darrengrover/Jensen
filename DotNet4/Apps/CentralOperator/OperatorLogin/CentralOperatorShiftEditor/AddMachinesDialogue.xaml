<Window x:Class="CentralOperatorShiftEditor.AddMachinesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Machines to Shift" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shift Information -->
        <GroupBox Header="Shift Information" Grid.Row="0" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Content="Shift Name:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="txtShiftName" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="5,0,20,0"/>

                <Label Grid.Column="2" Content="Time:" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" x:Name="txtShiftTime" 
                           FontWeight="Bold" 
                           VerticalAlignment="Center" 
                           Margin="5,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Search/Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="Search Machines:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="txtSearchMachines" 
                     TextChanged="TxtSearchMachines_TextChanged"
                     Margin="5,0,10,0"/>
            <Button Grid.Column="2" Content="Clear" Click="BtnClearSearch_Click" Width="60"/>
        </Grid>

        <!-- Available Machines List -->
        <GroupBox Header="Available Machines (select multiple)" Grid.Row="2" Margin="0,0,0,10">
            <DataGrid x:Name="dgAvailableMachines"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="40" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox x:Name="chkSelectAll" 
                                      Content="" 
                                      Checked="ChkSelectAll_Checked" 
                                      Unchecked="ChkSelectAll_Unchecked"
                                      ToolTip="Select/Deselect All"/>
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Machine ID" Binding="{Binding IdJensen}" Width="150"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Days of Week Selection -->
        <GroupBox Header="Apply to Days of Week" Grid.Row="3" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Individual day checkboxes -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <CheckBox x:Name="chkSunday" Content="Sunday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkMonday" Content="Monday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkTuesday" Content="Tuesday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkWednesday" Content="Wednesday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkThursday" Content="Thursday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkFriday" Content="Friday" Margin="0,0,20,0" Width="100"/>
                    <CheckBox x:Name="chkSaturday" Content="Saturday" Margin="0,0,20,0" Width="100"/>
                </WrapPanel>

                <!-- Quick selection buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Label Content="Quick Select:" VerticalAlignment="Center"/>
                    <Button Content="All Days" Click="BtnSelectAllDays_Click" Width="80" Margin="5,0"/>
                    <Button Content="Weekdays" Click="BtnSelectWeekdays_Click" Width="80" Margin="5,0"/>
                    <Button Content="Weekends" Click="BtnSelectWeekends_Click" Width="80" Margin="5,0"/>
                    <Button Content="Clear Days" Click="BtnClearDays_Click" Width="80" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="txtSelectionSummary" 
                       VerticalAlignment="Center" 
                       Margin="0,0,20,0"
                       Foreground="Gray"/>
            <Button Content="Add to Shift" 
                    Click="BtnOK_Click" 
                    IsDefault="True" 
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0"/>
            <Button Content="Cancel" 
                    Click="BtnCancel_Click" 
                    IsCancel="True" 
                    Width="100" 
                    Height="30"/>
        </StackPanel>
    </Grid>
</Window>
