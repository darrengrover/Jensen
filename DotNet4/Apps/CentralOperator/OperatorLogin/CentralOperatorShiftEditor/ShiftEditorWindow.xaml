<Window x:Class="CentralOperatorShiftEditor.ShiftEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shift Management Editor" Height="700" Width="1200" Closing="Window_Closing">
    <DockPanel>
        <!-- Status Bar at bottom -->
        <StatusBar DockPanel.Dock="Bottom" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Ready" />
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtUnsavedChanges" 
                           Text="" 
                           Foreground="Red" 
                           FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>
        <TabControl>
            <!-- Shifts Tab -->
            <TabItem Header="Shifts">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="200"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="3*" MinHeight="150"/>
                    </Grid.RowDefinitions>

                    <!-- TOP SECTION: Shifts List -->
                    <DockPanel Grid.Row="0">
                        <ToolBarTray DockPanel.Dock="Top">
                            <ToolBar>
                                <Button Content="Add Shift" Click="BtnAddShift_Click"/>
                                <Button Content="Delete Shift" Click="BtnDeleteShift_Click"/>
                                <Separator/>
                                <Button Content="Save" Click="BtnSaveShifts_Click"/>
                                <Button Content="Refresh" Click="BtnRefreshShifts_Click"/>
                            </ToolBar>
                        </ToolBarTray>

                        <DataGrid x:Name="dgShifts" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionChanged="DgShifts_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Shift ID" Binding="{Binding ShiftID}" IsReadOnly="True" Width="80"/>
                                <DataGridTextColumn Header="Shift Name" Binding="{Binding ShiftName}" Width="150"/>

                                <!-- Start Time with Template Column for better control -->
                                <DataGridTemplateColumn Header="Start Time" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartTime, StringFormat=hh\\:mm}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" 
                                             Text="{Binding StartTime, StringFormat=hh\\:mm, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             ToolTip="Format: HH:mm (e.g., 08:00)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- End Time with Template Column -->
                                <DataGridTemplateColumn Header="End Time" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding EndTime, StringFormat=hh\\:mm}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EndTime, StringFormat=hh\\:mm, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         ToolTip="Format: HH:mm (e.g., 16:00)"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delta Minus with Spinner Control -->
                                <DataGridTemplateColumn Header="Delta - (min)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeltaMinus}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" 
                                             Text="{Binding DeltaMinus, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewTextInput="NumberValidationTextBox"
                                             VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Width="18">
                                                    <Button Content="▲" 
                                                Height="14" 
                                                Padding="0" 
                                                FontSize="8"
                                                Click="BtnIncrementDeltaMinus_Click"
                                                ToolTip="Increase by 5"/>
                                                    <Button Content="▼" 
                                                Height="14" 
                                                Padding="0" 
                                                FontSize="8"
                                                Click="BtnDecrementDeltaMinus_Click"
                                                ToolTip="Decrease by 5"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delta Plus with Spinner Control -->
                                <DataGridTemplateColumn Header="Delta + (min)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeltaPlus}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" 
                                             Text="{Binding DeltaPlus, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewTextInput="NumberValidationTextBox"
                                             VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Vertical" Width="18">
                                                    <Button Content="▲" 
                                                Height="14" 
                                                Padding="0" 
                                                FontSize="8"
                                                Click="BtnIncrementDeltaPlus_Click"
                                                ToolTip="Increase"/>
                                                    <Button Content="▼" 
                                                Height="14" 
                                                Padding="0" 
                                                FontSize="8"
                                                Click="BtnDecrementDeltaPlus_Click"
                                                ToolTip="Decrease"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- SPLITTER -->
                    <GridSplitter Grid.Row="1" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                      Background="LightGray"
                      ShowsPreview="True"/>

                    <!-- BOTTOM SECTION: Machine Assignments for Selected Shift -->
                    <DockPanel Grid.Row="2">
                        <ToolBarTray DockPanel.Dock="Top">
                            <ToolBar>
                                <Label Content="Machines in Selected Shift:" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Separator/>
                                <Button Content="Add Machines..." Click="BtnAddMachinesToShift_Click" ToolTip="Add machines to this shift"/>
                                <Button Content="Remove Selected" Click="BtnRemoveMachineFromShift_Click" ToolTip="Remove selected assignments"/>
                                <Separator/>
                                <Button Content="Save Assignments" Click="BtnSaveShiftAssignments_Click"/>
                                <Button Content="Refresh" Click="BtnRefreshShiftMachines_Click"/>
                                <Separator/>
                                <TextBlock x:Name="txtShiftMachineCount" 
                               Text="0 assignments" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"
                               Foreground="Gray"/>
                            </ToolBar>
                        </ToolBarTray>

                        <!-- Machine assignments grid for selected shift -->
                        <DataGrid x:Name="dgShiftMachines" 
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Assignment ID" Binding="{Binding AssignmentID}" IsReadOnly="True" Width="100" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Machine ID" Binding="{Binding MachineIdJensen}" Width="150"/>
                                <DataGridTextColumn Header="Machine Description" Binding="{Binding MachineDescription}" Width="250"/>
                                <DataGridTextColumn Header="Day of Week" Binding="{Binding DayOfWeekName}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Shift Settings Tab -->
            <TabItem Header="Shift Settings">
                <DockPanel>
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar>
                            <Button Content="Save" Click="BtnSaveShiftSettings_Click"/>
                            <Button Content="Refresh" Click="BtnRefreshShiftSettings_Click"/>
                        </ToolBar>
                    </ToolBarTray>

                    <DataGrid x:Name="dgShiftSettings" 
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting ID" Binding="{Binding SettingID}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="Setting Name" Binding="{Binding SettingName}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding SettingValue}" Width="200"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Detail}" Width="400"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Operator Settings Tab -->
            <TabItem Header="Operator Settings">
                <DockPanel>
                    <ToolBarTray DockPanel.Dock="Top">
                        <ToolBar>
                            <Button Content="Add Setting" Click="BtnAddOperatorSetting_Click"/>
                            <Button Content="Delete Setting" Click="BtnDeleteOperatorSetting_Click"/>
                            <Separator/>
                            <Button Content="Save" Click="BtnSaveOperatorSettings_Click"/>
                            <Button Content="Refresh" Click="BtnRefreshOperatorSettings_Click"/>
                        </ToolBar>
                    </ToolBarTray>

                    <DataGrid x:Name="dgOperatorSettings"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting ID" Binding="{Binding OperatorSettingID}" IsReadOnly="True" Width="80"/>
                            <DataGridComboBoxColumn Header="Select Operator" x:Name="colOperatorSelect" Width="300">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AvailableOperators, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="DisplayMemberPath" Value="DisplayText"/>
                                        <Setter Property="SelectedValuePath" Value="RecNum"/>
                                        <Setter Property="SelectedValue" Value="{Binding OperatorRecNum, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Setter Property="IsReadOnly" Value="False"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.AvailableOperators, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Setter Property="DisplayMemberPath" Value="DisplayText"/>
                                        <Setter Property="SelectedValuePath" Value="RecNum"/>
                                        <Setter Property="SelectedValue" Value="{Binding OperatorRecNum, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridCheckBoxColumn Header="Can Replace Operator" Binding="{Binding CanReplaceOperator}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Can Logout During Shift" Binding="{Binding CanLogoutShift}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>