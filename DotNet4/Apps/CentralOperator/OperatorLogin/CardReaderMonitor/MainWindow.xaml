<Window x:Class="CardReaderMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tag Reader Monitor" Height="700" Width="1200"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tag Reader Status Monitor" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding ConnectionStatusText}" 
                               FontSize="14" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Ellipse Width="12" Height="12" 
                             Fill="{Binding ConnectionStatusColor}"
                             VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Reader Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl ItemsSource="{Binding Readers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#BDC3C7" 
                                BorderThickness="2" 
                                Background="{Binding StatusColor}" 
                                Margin="5" 
                                CornerRadius="5"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect Color="Gray" 
                                                  Direction="315" 
                                                  ShadowDepth="3" 
                                                  Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Machine/Sub ID -->
                                <TextBlock Text="{Binding DisplayText}" 
                                           FontWeight="Bold" 
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           Foreground="#2C3E50"/>

                                <!-- IP Address -->
                                <TextBlock Text="{Binding IpAddress}" 
                                           FontSize="11" 
                                           HorizontalAlignment="Center"
                                           Foreground="#7F8C8D"
                                           Margin="0,5,0,0"/>

                                <!-- Status Badge -->
                                <Border Background="{Binding StatusBadgeColor}"
                                        CornerRadius="3"
                                        Padding="5,2"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>

                                <!-- Operator Information -->
                                <TextBlock Text="{Binding OperatorInfo}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#2C3E50"
                                           Margin="0,6,0,0"/>

                                <!-- Connection Status -->
                                <StackPanel Orientation="Horizontal" 
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" 
                                             Fill="{Binding ConnectionDotColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ConnectionStatus}" 
                                               FontSize="10" 
                                               Foreground="#34495E"/>
                                </StackPanel>

                                <!-- Last Update -->
                                <TextBlock Text="{Binding LastUpdateText}" 
                                           FontSize="9" 
                                           Foreground="#95A5A6"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="12" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding LastRefreshText}" 
                           FontSize="11" 
                           Foreground="#BDC3C7"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
